# =============================================================================
# APISIX production stack — environment template (no secrets in this file)
#   ./scripts/gen-secrets.sh  -> copies this to .env and fills every __GENERATE__
#   .env gets mode 600 — never commit it
# =============================================================================

COMPOSE_PROJECT_NAME=apisix
TZ=Asia/Bangkok

# ---- Image versions (pinned; bump here when upgrading) ----------------------
APISIX_IMAGE=apache/apisix:3.19.0-debian
ETCD_IMAGE=quay.io/coreos/etcd:v3.7.2
ETCD_TOOLS_TAG=v3.7.2
ALPINE_IMAGE=alpine:3.24.2
PROMETHEUS_IMAGE=prom/prometheus:v3.15.0
ALERTMANAGER_IMAGE=prom/alertmanager:v0.34.1
GRAFANA_IMAGE=grafana/grafana:13.2.3
LOKI_IMAGE=grafana/loki:3.7.8
ALLOY_IMAGE=grafana/alloy:v1.20.1
NODE_EXPORTER_IMAGE=prom/node-exporter:v1.12.1
DEMO_IMAGE=nginx:1.31.6-alpine

# ---- APISIX ------------------------------------------------------------------
APISIX_HTTP_BIND=0.0.0.0
APISIX_HTTP_PORT=80
APISIX_HTTPS_BIND=0.0.0.0
APISIX_HTTPS_PORT=443
# Admin API + Dashboard: keep on loopback; use an SSH tunnel / VPN to reach it.
APISIX_ADMIN_BIND=127.0.0.1
APISIX_ADMIN_PORT=9180
APISIX_CPUS=2.0
APISIX_MEMORY=2g

# Admin API keys (admin = read/write, viewer = read-only)
APISIX_ADMIN_KEY=__GENERATE__
APISIX_VIEWER_KEY=__GENERATE__
# Encrypts SSL private keys & plugin secrets stored in etcd. EXACTLY 32 chars.
# Losing it = losing the ability to decrypt stored certs/secrets. Back it up!
APISIX_ENCRYPTION_KEY=__GENERATE__

# Docker network subnets (change if they clash with your LAN/VPN).
# The Admin API only accepts the gateway (.1) of each of these networks, i.e.
# requests coming in through the host's published 127.0.0.1:9180 port.
EDGE_SUBNET=172.30.0.0/24
OBSERVABILITY_SUBNET=172.30.1.0/24
UPSTREAM_SUBNET=172.30.2.0/24
ADMIN_ALLOW_GW_EDGE=172.30.0.1/32
ADMIN_ALLOW_GW_OBS=172.30.1.1/32
ADMIN_ALLOW_GW_UPSTREAM=172.30.2.1/32

# ---- etcd --------------------------------------------------------------------
ETCD_CLUSTER_TOKEN=apisix-etcd-cluster
ETCD_ROOT_PASSWORD=__GENERATE__
ETCD_APISIX_USER=apisix
ETCD_APISIX_PASSWORD=__GENERATE__
# Zero-permission user used only by the Docker healthcheck.
ETCD_HEALTHCHECK_PASSWORD=__GENERATE__

# ---- Observability (profile: observability) ---------------------------------
OBS_BIND=127.0.0.1
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION_TIME=30d
PROMETHEUS_RETENTION_SIZE=20GB
ALERTMANAGER_PORT=9093
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=__GENERATE__
GRAFANA_ROOT_URL=http://localhost:3000
GRAFANA_COOKIE_SECURE=false

# ---- Backups -----------------------------------------------------------------
BACKUP_RETENTION_DAYS=14
